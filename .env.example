# Supabase Cloud Configuration
# Copia questo file in .env e popola con le tue credenziali

# Management API Token (per gestire progetti e infrastruttura)
# Ottienilo da: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Project-specific keys (verranno popolate quando selezioni un progetto)
# Ottienile da: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development Environment
NODE_ENV=development

# FlutterFlow (Optional - solo se usi FlutterFlow)
FLUTTERFLOW_API_KEY=
FLUTTERFLOW_PROJECT_ID=

# v0.dev (Optional - solo se usi v0.dev)
V0_API_KEY=
