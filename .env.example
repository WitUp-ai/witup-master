# --- WITUP CONFIGURATION TEMPLATE ---
# Istruzioni: Copia questo contenuto in un file chiamato .env (nella root)
# Inserisci i valori reali forniti dal Project Manager.

# [1] SUPABASE (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=insert_your_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=insert_your_anon_key_here

# [2] GOOGLE SERVICES (Maps & AR)
GOOGLE_MAPS_API_KEY_ANDROID=insert_key_here
GOOGLE_MAPS_API_KEY_IOS=insert_key_here

# [3] AI & EXTERNAL SERVICES
OPENAI_API_KEY=insert_key_here
