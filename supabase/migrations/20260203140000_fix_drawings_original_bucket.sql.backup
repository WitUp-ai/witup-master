-- Migration: Fix drawings-original bucket policies - Add SELECT permission for service_role
-- Date: 2026-02-03 14:00:00
-- Description: Fix critical issue where Edge Functions (service_role) cannot read uploaded files
-- Root Cause: Missing SELECT policy for service_role on drawings-original bucket
-- Impact: AI Pipeline blocked with 404 errors

-- FIX STORAGE BUCKET & POLICIES
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. Assicura esistenza Bucket e Configurazione
INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
VALUES (
  'drawings-original', 'drawings-original', false, 10485760,
  '{image/jpeg,image/jpg,image/png,image/webp}'
)
ON CONFLICT (id) DO UPDATE SET
  public = false,
  file_size_limit = 10485760,
  allowed_mime_types = '{image/jpeg,image/jpg,image/png,image/webp}';

-- 2. Reset Policy (Pulizia completa)
DROP POLICY IF EXISTS "Authenticated users can upload drawings" ON storage.objects;
DROP POLICY IF EXISTS "Service role can read everything" ON storage.objects;
DROP POLICY IF EXISTS "Users can view own drawings" ON storage.objects;

-- 3. Policy UPLOAD (User -> Bucket)
CREATE POLICY "Authenticated users can upload drawings"
ON storage.objects FOR INSERT TO authenticated
WITH CHECK ( bucket_id = 'drawings-original' AND auth.uid() = owner );

-- 4. Policy LETTURA CRITICA (Service Role -> Bucket)
-- Questa mancava e causava il 404
CREATE POLICY "Service role can read everything"
ON storage.objects FOR SELECT TO service_role USING ( true );

-- 5. Policy LETTURA UTENTE (User -> Bucket)
CREATE POLICY "Users can view own drawings"
ON storage.objects FOR SELECT TO authenticated
USING ( bucket_id = 'drawings-original' AND auth.uid() = owner );

-- 6. Log della migrazione applicata
INSERT INTO system_config (key, value, description, category, is_sensitive)
VALUES (
  'BUCKET_FIX_APPLIED_20260203',
  'true',
  'Fix per bucket drawings-original: aggiunta policy SELECT per service_role',
  'system',
  false
)
ON CONFLICT (key) DO UPDATE SET
  value = 'true',
  updated_at = NOW();

-- Commento esplicativo per Claude Code:
/*
ANALISI RISOLUZIONE:
1. PRIMA: Upload OK (policy INSERT per auth) ma lettura FAIL (mancava SELECT per service_role)
2. DOPO: 
   - Utenti autenticati possono UPLOAD (policy 3)
   - Service Role (Edge Functions) possono LEGGERE (policy 4 - CRITICA)
   - Utenti autenticati possono vedere i propri file (policy 5)

TEST POST-FIX:
1. Caricare un'immagine tramite app → dovrebbe funzionare (policy 3)
2. Edge Function process-drawing dovrebbe ora poter leggere il file (policy 4)
3. Utente dovrebbe vedere la propria galleria (policy 5)

ERRORE RISOLTO: 404 Not Found quando Edge Functions tentano di accedere ai file caricati.
*/