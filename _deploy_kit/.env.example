# --- WITUP CONFIGURATION TEMPLATE ---
# ISTRUZIONI PER L'AI:
# Quando devi attivare una feature (es. Login Google), controlla qui il nome della variabile.
# Se la variabile manca nel file .env reale, FERMATI e chiedila all'utente.

# [1] CORE: DATABASE & AUTH (Supabase - Obbligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [2] SOCIAL AUTH (Se richiesto dal progetto)
# Usare solo se specificato nelle features di login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# [3] GEOLOCATION (Google Maps - Se richiesto)
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# [4] AI SERVICES (OpenAI/Anthropic - Se richiesto)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# [5] PAYMENTS (Stripe - Se richiesto)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# [6] EXTRAS
# Aggiungere qui sotto altre chiavi specifiche del progetto se necessarie
